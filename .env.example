# Copy this file to ".env" and fill in values ONLY if you want the optional LLM features.
# QuestMaster works without any key: it falls back to a rule-based/knowledge-base NPC.

# Set to "true" to try an LLM-powered NPC when a key is available
USE_LLM=false

# Optional: any one provider (leave blank if unused)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: local model via Ollama (free, runs on your computer)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Random seed so results are reproducible
RANDOM_SEED=42
